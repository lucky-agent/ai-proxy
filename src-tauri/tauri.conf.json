{
  "$schema": "https://raw.githubusercontent.com/nickel-lang/json-schema-store/main/tauri/v2/schema.json",
  "productName": "AI Proxy",
  "version": "0.1.0",
  "identifier": "com.ai-proxy.app",
  "build": {
    "beforeDevCommand": "bun run dev:vite",
    "devUrl": "http://127.0.0.1:5205",
    "beforeBuildCommand": "bun run build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Proxy",
        "decorations": false,
        "dragDropEnabled": false,
        "width": 1200,
        "height": 780,
        "minWidth": 1024,
        "minHeight": 600,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "backgroundColor": "#fafbfb"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: http:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https: http:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwN0U0RUYxNTRFRjRGQzAKUldUQVQrOVU4VTUrd05XeHF6K21VU050RmlJZTlsL2tpQzlSNERqNEI5ZEJxUE5WSEpVNHI5cHEK",
      "endpoints": ["https://github.com/lucky-agent/ai-proxy/releases/latest/download/latest.json"]
    }
  }
}
