{
  "$schema": "https://json.schemastore.org/prettierrc",
  "printWidth": 100,
  "tabWidth": 2,
  "singleQuote": true,
  "semi": false,
  "bracketSameLine": true,
  "bracketSpacing": true,
  "endOfLine": "lf",
  "arrowParens": "avoid",
  "useTabs": false,
  "trailingComma": "es5",
  "htmlWhitespaceSensitivity": "css"
}
